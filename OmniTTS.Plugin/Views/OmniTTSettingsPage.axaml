<ci2:SettingsPageBase xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:ci="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
             xmlns:ci2="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="OmniTTS.Plugin.OmniTTSettingsPage"
             xmlns:vm="using:OmniTTS.Plugin.ViewModels"
             x:DataType="vm:SettingsPageViewModel">
    <ci2:SettingsPageBase.DataContext>
		<vm:SettingsPageViewModel/>
    </ci2:SettingsPageBase.DataContext>
    <ci2:SettingsPageBase.Resources>
        <ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>
			    <ResourceDictionary x:Key="Light">
                    <x:String x:Key="OpenAI_Icon">avares://OmniTTS.Plugin/Assets/openai-black.svg</x:String>
                    <x:String x:Key="Gemini_Icon">
                        avares://OmniTTS.Plugin/Assets/gemini-black.svg
                    </x:String>
                    <x:String x:Key="FishAudio_Icon">
                        avares://OmniTTS.Plugin/Assets/elevenlabs-black.svg
                    </x:String>
                    <x:String x:Key="ElevenLabs_Icon">
                        avares://OmniTTS.Plugin/Assets/elevenlabs-black.svg
                    </x:String>
                    <x:String x:Key="MiniMax_Icon">
                        avares://OmniTTS.Plugin/Assets/minimax-black.svg
                    </x:String>
                    <x:String x:Key="Qwen_Icon">
                        avares://OmniTTS.Plugin/Assets/qwen-black.svg
                    </x:String>
                    <x:String x:Key="MiMo_Icon">
                        avares://OmniTTS.Plugin/Assets/xiaomimimo-black.svg
                    </x:String>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <x:String x:Key="OpenAI_Icon">
                        avares://OmniTTS.Plugin/Assets/openai-white.svg
                    </x:String>
                    <x:String x:Key="Gemini_Icon">
                        avares://OmniTTS.Plugin/Assets/gemini-white.svg
                    </x:String>
                    <x:String x:Key="FishAudio_Icon">
                        avares://OmniTTS.Plugin/Assets/fishaudio-white.svg
                    </x:String>
                    <x:String x:Key="ElevenLabs_Icon">
                        avares://OmniTTS.Plugin/Assets/elevenlabs-white.svg
                    </x:String>
                    <x:String x:Key="MiniMax_Icon">
                        avares://OmniTTS.Plugin/Assets/minimax-white.svg
                    </x:String>
                    <x:String x:Key="Qwen_Icon">
                        avares://OmniTTS.Plugin/Assets/qwen-white.svg
                    </x:String>
                    <x:String x:Key="MiMo_Icon">
                        avares://OmniTTS.Plugin/Assets/xiaomimimo-white.svg
                    </x:String>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </ci2:SettingsPageBase.Resources>
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <ci:IconText Glyph="&#xEF27;" Text="基本设置" />
      <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xED53;}" Header="默认 TTS" Description="未指定提供方时使用的 TTS 提供方">
        <fa:FASettingsExpander.Footer>
          <ComboBox x:Name="DefaultProviderComboBox" Width="180"
                    ItemsSource="{Binding Providers}"
                    SelectedItem="{Binding SelectedProviderPair}">
              <ComboBox.ItemTemplate>
				 <DataTemplate>
					<TextBlock Text="{Binding Value}"/> 
                 </DataTemplate> 
              </ComboBox.ItemTemplate>
          </ComboBox>
        </fa:FASettingsExpander.Footer>

      </fa:FASettingsExpander>
        <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xED53;}" Header="最大并发量" Description="同时请求API的最大次数">
        <fa:FASettingsExpander.Footer>
          <StackPanel Orientation="Horizontal">
			  <TextBlock VerticalAlignment="Center" Margin="12,0" FontSize="15" Text="{Binding MaxConcurrentRequests}"/>
              <Slider Minimum="1" Maximum="20"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      VerticalAlignment="Center"
                      Width="180"
                      Value="{Binding MaxConcurrentRequests}"/>
          </StackPanel>
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>

      <ci:IconText Glyph="&#xEF27;" Text="提供方设置" />
      <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xE28A;}" Header="TTS 提供方" Description="配置已启用的提供方">
        <fa:FASettingsExpanderItem Tag="OpenAI" IsClickEnabled="True" Click="Provider_Click">
			<fa:FASettingsExpanderItem.Content>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<svg:Svg Path="{DynamicResource OpenAI_Icon}" VerticalAlignment="Center" Height="20" Width="20"/>
                    <TextBlock Text="OpenAI" Margin="6,0" VerticalAlignment="Center"/>
                </StackPanel>
            </fa:FASettingsExpanderItem.Content>
        </fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Tag="Gemini" IsClickEnabled="True" Click="Provider_Click">
			<fa:FASettingsExpanderItem.Content>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<svg:Svg Path="{DynamicResource Gemini_Icon}" VerticalAlignment="Center" Height="20" Width="20"/>
                    <TextBlock Text="Gemini" Margin="6,0" VerticalAlignment="Center"/>
                </StackPanel>
            </fa:FASettingsExpanderItem.Content>
        </fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Tag="FishAudio" IsClickEnabled="True" Click="Provider_Click">
			<fa:FASettingsExpanderItem.Content>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<svg:Svg Path="{DynamicResource FishAudio_Icon}" VerticalAlignment="Center" Height="20" Width="20"/>
                    <TextBlock Text="FishAudio" Margin="6,0" VerticalAlignment="Center"/>
                </StackPanel>
            </fa:FASettingsExpanderItem.Content>
        </fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Tag="Elevenlabs" IsClickEnabled="True" Click="Provider_Click">
			<fa:FASettingsExpanderItem.Content>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<svg:Svg Path="{DynamicResource ELevenLabs_Icon}" VerticalAlignment="Center" Height="20" Width="20"/>
                    <TextBlock Text="ElevenLabs" Margin="6,0" VerticalAlignment="Center"/>
                </StackPanel>
            </fa:FASettingsExpanderItem.Content>
        </fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Tag="MiniMax" IsClickEnabled="True" Click="Provider_Click">
			<fa:FASettingsExpanderItem.Content>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<svg:Svg Path="{DynamicResource MiniMax_Icon}" VerticalAlignment="Center" Height="20" Width="20"/>
                    <TextBlock Text="MiniMax" Margin="6,0" VerticalAlignment="Center"/>
                </StackPanel>
            </fa:FASettingsExpanderItem.Content>
        </fa:FASettingsExpanderItem>
        <fa:FASettingsExpanderItem Tag="MiMo" IsClickEnabled="True" Click="Provider_Click">
			<fa:FASettingsExpanderItem.Content>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<svg:Svg Path="{DynamicResource MiMo_Icon}" VerticalAlignment="Center" Height="20" Width="20"/>
                    <TextBlock Text="MiMo" Margin="6,0" VerticalAlignment="Center"/>
                </StackPanel>
            </fa:FASettingsExpanderItem.Content>
        </fa:FASettingsExpanderItem>
      </fa:FASettingsExpander>
    </StackPanel>
  </ScrollViewer>
</ci2:SettingsPageBase>
