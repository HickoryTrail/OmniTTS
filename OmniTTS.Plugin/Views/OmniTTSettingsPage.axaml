<ci2:SettingsPageBase xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:ci="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
             xmlns:ci2="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
             x:Class="OmniTTS.Plugin.OmniTTSettingsPage"
             xmlns:vm="using:OmniTTS.Plugin.ViewModels"
             x:DataType="vm:SettingsPageViewModel">
    <ci2:SettingsPageBase.DataContext>
		<vm:SettingsPageViewModel/>
    </ci2:SettingsPageBase.DataContext>
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <ci:IconText Glyph="&#xEF27;" Text="基本设置" />
      <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xED53;}" Header="默认 TTS" Description="未指定提供方时使用的 TTS 提供方">
        <fa:FASettingsExpander.Footer>
          <ComboBox x:Name="DefaultProviderComboBox" Width="180"
                    ItemsSource="{Binding Providers}"
                    SelectedItem="{Binding SelectedProviderPair}">
              <ComboBox.ItemTemplate>
				 <DataTemplate>
					<TextBlock Text="{Binding Value}"/> 
                 </DataTemplate> 
              </ComboBox.ItemTemplate>
          </ComboBox>
        </fa:FASettingsExpander.Footer>

      </fa:FASettingsExpander>
        <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xED53;}" Header="最大并发量" Description="同时请求API的最大次数">
        <fa:FASettingsExpander.Footer>
          <StackPanel Orientation="Horizontal">
			  <TextBlock VerticalAlignment="Center" Margin="12,0" FontSize="15" Text="{Binding MaxConcurrentRequests}"/>
              <Slider Minimum="1" Maximum="20"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      VerticalAlignment="Center"
                      Width="180"
                      Value="{Binding MaxConcurrentRequests}"/>
          </StackPanel>
        </fa:FASettingsExpander.Footer>
      </fa:FASettingsExpander>

      <ci:IconText Glyph="&#xEF27;" Text="提供方设置" />
      <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xE28A;}" Header="TTS 提供方" Description="配置已启用的提供方">
        <fa:FASettingsExpanderItem Content="OpenAI" Tag="OpenAI" IsClickEnabled="True" Click="Provider_Click" />
        <fa:FASettingsExpanderItem Content="Gemini" Tag="Gemini" IsClickEnabled="True" Click="Provider_Click" />
        <fa:FASettingsExpanderItem Content="Fish Audio" Tag="FishAudio" IsClickEnabled="True" Click="Provider_Click" />
        <fa:FASettingsExpanderItem Content="ElevenLabs" Tag="Elevenlabs" IsClickEnabled="True" Click="Provider_Click" />
        <fa:FASettingsExpanderItem Content="MiniMax" Tag="MiniMax" IsClickEnabled="True" Click="Provider_Click" />
        <fa:FASettingsExpanderItem Content="MiMo" Tag="MiMo" IsClickEnabled="True" Click="Provider_Click" />
      </fa:FASettingsExpander>
    </StackPanel>
  </ScrollViewer>
</ci2:SettingsPageBase>
